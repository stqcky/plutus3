pragma solidity ^0.8.13;

import {Test, console} from "forge-std/Test.sol";
import {Executor} from "../src/Executor.sol";

contract ExecutorTest is Test {
    Executor executor;

    function setUp() public {
        vm.createSelectFork("http://localhost:8547", 310815260);
        vm.startBroadcast();

        deployCodeTo("Executor.sol", address(0x4e7B447cF5DA9521e9a2222Fb77BAdcb299708E4));
        executor = Executor(payable(address(0x4e7B447cF5DA9521e9a2222Fb77BAdcb299708E4)));
    }

    function test_run() public {
        address target = 0x9FCBC372A15E96E85ACF37C84C91DA21dA005398;

        bytes memory data = vm.parseBytes(
            ""
        );

        executor.execute1695833(target, data);

        vm.stopBroadcast();
    }
}
